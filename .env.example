# Entorno de ejecución

APP_ENV=development

# Configuración general

PROJECT_NAME=smart-city-climate-platform
LOG_LEVEL=INFO

# API de Open-Meteo

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Rutas locales

BRONZE_PATH=data/bronze
SILVER_PATH=data/silver
GOLD_PATH=data/gold
QUARANTINE_PATH=data/quarantine

# Google Cloud

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_BRONZE=your-bronze-bucket
GCS_BUCKET_SILVER=your-silver-bucket
GCS_BUCKET_GOLD=your-gold-bucket
GCS_BUCKET_QUARANTINE=your-quarantine-bucket

# BigQuery

BIGQUERY_DATASET=climate_platform
BIGQUERY_LOCATION=US

# Pub/Sub

PUBSUB_TOPIC=climate-events
PUBSUB_SUBSCRIPTION=climate-events-sub
